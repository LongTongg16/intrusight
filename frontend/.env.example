# Base URL of the single FastAPI backend.
VITE_API_BASE=http://localhost:8000

# Optional per-area overrides read by src/services/api.js. Both default to
# VITE_API_BASE; set them only if auth and alerts are served separately.
# VITE_AUTH_URL=http://localhost:8000
# VITE_ALERTS_URL=http://localhost:8000
