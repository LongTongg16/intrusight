# Copy this file to backend/.env. The backend loads that file automatically, so
# local values persist across terminal sessions without being exported. Replace
# every angle-bracket placeholder; this tracked example intentionally has no
# usable secret values.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=siemless_db

# MONGODB_URL above is the single connection variable for the whole backend: the
# async Motor client and the synchronous alert client both read it. An earlier
# MONGO_URI override existed and has been removed; do not reintroduce it.

# Generate with: openssl rand -hex 32
SECRET_KEY=<generate-with-openssl-rand-hex-32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generate independently with: openssl rand -hex 32
INGEST_API_KEY=<generate-a-separate-ingestion-key>

# Comma-separated browser origins; do not use * in production.
CORS_ORIGINS=http://localhost:5173

# Optional integrations
#
# The historical Telegram bot integration has been removed. IntruSight no longer
# reads TELEGRAM_BOT_TOKEN and cannot send Telegram messages; the bot identity
# formerly associated with this project is not trusted. Do not reintroduce it.
KISMET_API_KEY=
KISMET_URL=http://localhost:2501/alerts/last-time/{}/alerts.json
GEOIP_DB_PATH=geoip/GeoLite2-City.mmdb

# Ingestor settings
API_URL=http://localhost:8000/api/ingest/alerts
SEVERITY_THRESHOLD=2

# Optional backward-compatible local override for backend/tools/demo.py.
# Remote targets should be selected interactively with --custom instead of
# storing their API address or ingestion key in this file.
# DEMO_API_BASE=http://localhost:8000

# Engine-specific input paths. Each ingestor and its matching simulator read the
# engine-specific variable first and fall back to the legacy ALERTS_FILE_PATH,
# which both Suricata and Snort used to share.
SURICATA_EVE_PATH=/path/to/suricata/eve.json
SNORT_ALERT_PATH=/path/to/snort/alert_json.txt
ZEEK_LOG_FILE=/path/to/zeek/notice.log
# ALERTS_FILE_PATH=/path/to/ids/alert-log

# Optional; defaults to backend/backups when the API runs.
# BACKUP_DIR=/absolute/path/to/private/backup-directory
